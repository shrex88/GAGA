# TRACEFLOW AI Environment Configuration
APP_NAME="TRACEFLOW AI"
APP_ENV=development
APP_AUTH_MODE=demo
SECRET_KEY=change-this-to-a-strong-64-char-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Development-only demo password (ignored when APP_ENV != development)
DEMO_USER_PASSWORD=TraceflowDemo@2026!

# Database (PostgreSQL for Docker/Production, SQLite fallback for local dev)
DATABASE_URL=sqlite:///./traceflow.db
# DATABASE_URL=postgresql+psycopg://traceflow:traceflow_pass@localhost:5432/traceflow_db

# Neo4j Graph Database (optional; falls back to NetworkX if unavailable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=traceflow_neo4j

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Upload limits (MB)
MAX_UPLOAD_MB=25
